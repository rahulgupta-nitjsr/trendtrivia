# ===============================================
# TrendTrivia Environment Variables
# ===============================================
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to GitHub!

# ===============================================
# 🔥 FIREBASE CONFIGURATION
# ===============================================
# Get these values from your Firebase Console:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

# Your Firebase API Key (from Firebase project settings)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here

# Your Firebase Auth Domain (usually: your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Your Firebase Project ID (from Firebase project settings)
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id

# Your Firebase Storage Bucket (usually: your-project-id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Your Firebase Messaging Sender ID (from Firebase project settings)
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Your Firebase App ID (from Firebase project settings)
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# ===============================================
# 🤖 PERPLEXITY AI CONFIGURATION
# ===============================================
# Get your API key from: https://www.perplexity.ai/settings/api

# Your Perplexity API Key (required for AI question generation)
VITE_PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here

# Perplexity API Endpoint (optional - uses default if not set)
VITE_PERPLEXITY_API_ENDPOINT=https://api.perplexity.ai/chat/completions

# Perplexity Model (optional - uses 'sonar' if not set)
VITE_PERPLEXITY_MODEL=sonar

# Maximum tokens for AI responses (optional - uses 2000 if not set)
VITE_PERPLEXITY_MAX_TOKENS=2000

# Temperature for AI responses (optional - uses 0.2 if not set)
# Range: 0.0 (deterministic) to 1.0 (creative)
VITE_PERPLEXITY_TEMPERATURE=0.2

# ===============================================
# 🔧 DEVELOPMENT CONFIGURATION
# ===============================================
# These are automatically set by Vite, but you can override them

# Development mode (automatically set by Vite)
# VITE_DEV=true

# Node environment (automatically set)
# NODE_ENV=development

# ===============================================
# 📝 NOTES FOR DEVELOPERS
# ===============================================
#
# 1. SECURITY: Never commit this file with real values!
#    The .gitignore file should exclude .env files.
#
# 2. FIREBASE SETUP:
#    - Create a Firebase project at https://console.firebase.google.com
#    - Enable Firestore Database
#    - Copy the config values from Project Settings > General
#
# 3. PERPLEXITY SETUP:
#    - Sign up at https://www.perplexity.ai
#    - Go to Settings > API to get your key
#    - The app uses this for AI-powered quiz generation
#
# 4. DEVELOPMENT:
#    - Run Firebase emulators: firebase emulators:start
#    - Run React app: npm run dev
#    - The app will connect to emulators in development mode
#
# 5. TROUBLESHOOTING:
#    - Check browser console for missing environment variable warnings
#    - Make sure all VITE_ prefixed variables are set
#    - Firebase variables are required for database functionality
#    - Perplexity API key is required for AI question generation
#
# ===============================================
