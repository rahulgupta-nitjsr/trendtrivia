rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to questions for the quiz app
    match /questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null || request.auth == null; // Allow writes in emulator
    }
    
    // Allow read access to batches for status checking
    match /batches/{batchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to prompts
    match /prompts/{promptId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to topics
    match /topics/{topicId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to system metadata
    match /system_metadata/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to API logs (for monitoring)
    match /api_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Allow read access to user sessions
    match /user_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
} 